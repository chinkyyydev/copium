# ── Claude (the brain) ────────────────────────────────────────────────
# Get a key at https://console.anthropic.com  → API keys
ANTHROPIC_API_KEY=

# Model. Default is claude-opus-4-8 (highest quality).
# For high-volume posting, claude-sonnet-5 or claude-haiku-4-5 are much cheaper
# and still write her voice well. Swap here without touching code.
COPIUM_MODEL=claude-opus-4-8

# ── Discord review gate ───────────────────────────────────────────────
# Two ways to review drafts — use EITHER:
#
# (A) Buttons bot (recommended — approve/reject from your phone).
#     Run `npm run bot` as a long-running process. It posts each draft with
#     Approve & Post / Reject / Regenerate buttons.
#       1. discord.com/developers/applications → New Application → Bot → Reset Token
#       2. OAuth2 → URL Generator → scopes: bot → perms: Send Messages, Embed Links → add to server
#       3. Enable Developer Mode, right-click your review channel → Copy Channel ID
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
#
# (B) Plain webhook (a text notification only, no buttons — approve via CLI).
#     Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# ── X / Twitter API (needed only to actually publish) ─────────────────
# From https://developer.x.com  → your app → Keys and tokens.
# You need a project with Read+Write, and user (OAuth 1.0a) access tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────
# Timezone used to pick the posting slot in `run` (see src/schedule.ts).
COPIUM_TZ=America/New_York
