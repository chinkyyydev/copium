# --- Brain (required) ---
ANTHROPIC_API_KEY=
# Chat model. Sonnet 5 is the sweet spot for live chat (fast + in-voice).
# The poster uses Opus for crafted posts; chat needs latency more than polish.
COPIUM_CHAT_MODEL=claude-sonnet-5

# --- Voice (optional — chat works text-only without these) ---
# elevenlabs.io -> profile -> API key
ELEVENLABS_API_KEY=
# Create her voice with ElevenLabs Voice Design using the doc-08 casting spec:
# "early-20s female, bright and quick, smug lilt, capable of deadpan flatness
#  and sudden warmth; speaks slightly fast; laughs easily"
# then paste the saved voice id here.
ELEVENLABS_VOICE_ID=

# --- Server ---
PORT=3000
